<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Remove "Powered by Odoo" and right border on "Manage Databases" in Login Layout -->
    <template id="login_layout_debrand" inherit_id="web.login_layout" priority="99">
        <xpath expr="//a[contains(@href, 'odoo.com')]" position="replace"/>
        <xpath expr="//a[@href='/web/database/manager']" position="attributes">
            <attribute name="class"></attribute>
        </xpath>
    </template>

    <!-- Remove "Powered by Odoo" from Brand Promotion Message (Portal / Website footers) -->
    <template id="brand_promotion_message_debrand" inherit_id="web.brand_promotion_message" priority="99">
        <xpath expr="." position="replace">
            <t/>
        </xpath>
    </template>

    <!-- Remove Brand Promotion container -->
    <template id="brand_promotion_debrand" inherit_id="web.brand_promotion" priority="99">
        <xpath expr="//div[hasclass('o_brand_promotion')]" position="replace"/>
    </template>
</odoo>
